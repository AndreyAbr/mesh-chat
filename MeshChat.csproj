<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeshChat</RootNamespace>
    <AssemblyName>MeshChat</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);MeshChat.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MeshChat.Tests\**" />
    <Content Remove="MeshChat.Tests\**" />
    <EmbeddedResource Remove="MeshChat.Tests\**" />
    <None Remove="MeshChat.Tests\**" />
  </ItemGroup>

</Project>
